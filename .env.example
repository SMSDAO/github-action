# GitHub token for Renovate to authenticate with the GitHub API.
# Can be a personal access token (PAT) or a GitHub App token.
RENOVATE_TOKEN=your_github_token_here

# Optional: Set Renovate log level (debug, info, warn, error). Default: info
LOG_LEVEL=info

# Optional: Path to the Renovate configuration file
RENOVATE_CONFIG_FILE=./renovate.json

# Optional: Personal access token for github.com when running on GitHub Enterprise
# GITHUB_COM_TOKEN=your_github_com_token
